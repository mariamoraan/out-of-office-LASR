# Neon PostgreSQL connection string
# Dashboard → Project → Connection details → URI
# Prefer the pooled connection for the app runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require"

# Optional: direct (non-pooled) URL for migrations if you use Neon's pooler
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require"

# Private admin dashboard (/dashboard) — required for login; fail closed if missing
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
# Long random string used to sign the admin session cookie (keep secret, stable per env)
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"
